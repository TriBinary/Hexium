{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Edit(server/deploy/**)",
      "Write(server/deploy/**)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/core-tests.sh\""
          }
        ]
      }
    ]
  }
}
